# Copy this file to .env in the project root and fill in the values.
# Every key the app reads is listed here. Process environment variables with the
# same names also work and take precedence over .env.

# --- Database (PostgreSQL) - required ---
# Local example: jdbc:postgresql://localhost:5432/clinic_booking
# Hosted example: jdbc:postgresql://your-host/your-db?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/clinic_booking
DB_USERNAME=clinic_app
DB_PASSWORD=change-me

# --- Email / SMTP (booking confirmations, reminders, password reset) - optional ---
# If these are blank the app still runs but logs an [Email] WARNING and sends nothing.
# Gmail: use an App Password, not your normal password (README -> Getting API keys / credentials).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
MAIL_FROM=your-email@gmail.com
# Display name shown as the sender (optional)
MAIL_FROM_NAME=Sexual Health Clinic

# The clinic map (OpenStreetMap tiles via Leaflet) and postcode lookup (api.postcodes.io)
# are free public services and need no API key.
