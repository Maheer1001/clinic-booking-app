<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      styleClass="auth-page"
      stylesheets="@../css/auth.css">

    <VBox styleClass="auth-heading">
        <Label text="HEALTH TRACKING &amp; APPOINTMENTS" styleClass="auth-brand"/>
        <Label text="Welcome back" styleClass="title"/>
        <Label text="Log in to book and track your appointments." styleClass="subtitle"/>
    </VBox>

    <VBox styleClass="auth-card">
        <TextField fx:id="emailField"
                   promptText="Email"
                   accessibleText="Email"
                   styleClass="input"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       accessibleText="Password"
                       styleClass="input"/>

        <Button fx:id="continueBtn"
                text="Log in"
                onAction="#onLogin"
                defaultButton="true"
                maxWidth="Infinity"
                styleClass="primaryBtn"/>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               styleClass="error"/>

        <HBox styleClass="auth-footer">
            <Label text="New here?" styleClass="muted"/>
            <Button text="Create an account"
                    onAction="#goToSignUp"
                    styleClass="secondaryBtn"/>
        </HBox>

        <HBox styleClass="auth-footer">
            <Button text="Forgot your password?"
                    onAction="#goToPasswordReset"
                    styleClass="secondaryBtn"/>
        </HBox>
    </VBox>

</VBox>
