<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.SignUpController"
      styleClass="auth-page"
      stylesheets="@../css/auth.css">

    <VBox styleClass="auth-heading">
        <Label text="HEALTH TRACKING &amp; APPOINTMENTS" styleClass="auth-brand"/>
        <Label text="Create your account" styleClass="title"/>
        <Label text="Book appointments and keep track of tests and treatment." styleClass="subtitle" wrapText="true" minHeight="-Infinity"/>
    </VBox>

    <VBox styleClass="auth-card">
        <TextField fx:id="emailField" promptText="Email" accessibleText="Email" styleClass="input"/>
        <Label fx:id="emailErrorLabel" styleClass="auth-field-error"/>

        <PasswordField fx:id="passwordField" promptText="Password" accessibleText="Password" styleClass="input"/>
        <Label fx:id="passwordRulesLabel" styleClass="auth-hint"/>

        <PasswordField fx:id="confirmPasswordField" promptText="Confirm password"
                       accessibleText="Confirm password" styleClass="input"/>
        <Label fx:id="confirmErrorLabel" styleClass="auth-field-error"/>

        <Label text="Security question" styleClass="auth-field-label"/>
        <ComboBox fx:id="questionBox" maxWidth="Infinity" styleClass="input"/>
        <Label fx:id="questionHintLabel" styleClass="auth-hint" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="answerField" promptText="Your answer" accessibleText="Security answer" styleClass="input"/>
        <Label fx:id="answerErrorLabel" styleClass="auth-field-error"/>

        <VBox styleClass="auth-check-group">
            <HBox spacing="4" alignment="BASELINE_LEFT">
                <CheckBox fx:id="termsCheck" text="I agree to the" styleClass="auth-check"/>
                <Hyperlink text="Terms of Service" onAction="#goToTerms" styleClass="auth-link"/>
            </HBox>
            <HBox spacing="4" alignment="BASELINE_LEFT">
                <CheckBox fx:id="privacyCheck" text="I agree to the" styleClass="auth-check"/>
                <Hyperlink text="Privacy Policy" onAction="#goToPrivacy" styleClass="auth-link"/>
            </HBox>
            <Label fx:id="termsHintLabel"
                   text="Open each document and scroll to the end to enable its checkbox."
                   styleClass="auth-hint"/>
        </VBox>

        <Button fx:id="createBtn" text="Create account" onAction="#onSignUp" defaultButton="true"
                maxWidth="Infinity" styleClass="primaryBtn"/>

        <Label fx:id="messageLabel" text="" wrapText="true" styleClass="error"/>

        <HBox styleClass="auth-footer">
            <Label text="Already have an account?" styleClass="muted"/>
            <Button text="Log in" onAction="#goToLogin" styleClass="secondaryBtn"/>
        </HBox>
    </VBox>

</VBox>
