<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.PasswordResetController"
      styleClass="auth-page">

    <VBox styleClass="auth-heading">
        <Label text="Health Tracking and&#10;Appointments" styleClass="title"/>
        <Label text="Password reset" styleClass="subtitle"/>
    </VBox>

    <VBox styleClass="auth-card" spacing="10">

        <TextField fx:id="emailField"
                   promptText="email@domain.com"
                   styleClass="input"/>

        <Button fx:id="sendOtpBtn"
                text="Send OTP"
                onAction="#onSendOtp"
                styleClass="secondaryWideBtn"/>

        <Separator/>

        <TextField fx:id="otpField"
                   promptText="Enter OTP code"
                   styleClass="input"/>

        <Button fx:id="verifyOtpBtn"
                text="Reset password"
                onAction="#onVerifyOtp"
                styleClass="secondaryWideBtn"/>

        <VBox fx:id="newPasswordBox" spacing="10" visible="false" managed="false">
            <Label text="OTP validated" styleClass="muted"/>

            <PasswordField fx:id="newPasswordField"
                           promptText="New password"
                           styleClass="input"/>

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm new password"
                           styleClass="input"/>

            <Button fx:id="confirmResetBtn"
                    text="Confirm password reset"
                    onAction="#onConfirmReset"
                    styleClass="primaryBtn"/>
        </VBox>

        <Button text="Back to login"
                onAction="#goToLogin"
                styleClass="secondaryBtn"/>

        <Label fx:id="messageLabel"
               text=""
               styleClass="error"/>

    </VBox>

</VBox>

