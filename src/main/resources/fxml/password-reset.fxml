<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.PasswordResetController"
      styleClass="auth-page"
      stylesheets="@../css/auth.css">

    <VBox styleClass="auth-heading">
        <Label text="HEALTH TRACKING &amp; APPOINTMENTS" styleClass="auth-brand"/>
        <Label text="Reset your password" styleClass="title"/>
        <Label text="We'll email you a 6-digit code to confirm it's you."
               styleClass="subtitle" wrapText="true"/>
    </VBox>

    <VBox styleClass="auth-card" spacing="10">

        <VBox styleClass="auth-step">
            <Label text="Email" styleClass="auth-field-label"/>
            <TextField fx:id="emailField"
                       promptText="you@example.com"
                       onAction="#onSendOtp"
                       styleClass="input"
                       accessibleText="Email"/>
            <Button fx:id="sendOtpBtn"
                    text="Send code"
                    onAction="#onSendOtp"
                    maxWidth="Infinity"
                    styleClass="secondaryWideBtn"/>
        </VBox>

        <Separator/>

        <VBox styleClass="auth-step">
            <Label text="6-digit code" styleClass="auth-field-label"/>
            <TextField fx:id="otpField"
                       promptText="123456"
                       onAction="#onVerifyOtp"
                       styleClass="input"
                       accessibleText="6-digit code"/>
            <Button fx:id="verifyOtpBtn"
                    text="Verify code"
                    onAction="#onVerifyOtp"
                    maxWidth="Infinity"
                    styleClass="secondaryWideBtn"/>
        </VBox>

        <VBox fx:id="newPasswordBox" spacing="8" visible="false" managed="false">
            <Label text="Code verified. Choose a new password." styleClass="auth-success"/>

            <PasswordField fx:id="newPasswordField"
                           promptText="New password"
                           styleClass="input"
                           accessibleText="New password"/>
            <Label fx:id="passwordRulesLabel" styleClass="auth-hint"/>

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm new password"
                           onAction="#onConfirmReset"
                           styleClass="input"
                           accessibleText="Confirm new password"/>
            <Label fx:id="confirmErrorLabel" styleClass="auth-field-error"/>

            <Button fx:id="confirmResetBtn"
                    text="Update password"
                    onAction="#onConfirmReset"
                    maxWidth="Infinity"
                    styleClass="primaryBtn"/>
        </VBox>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               styleClass="error"/>

        <HBox styleClass="auth-footer">
            <Button text="Back to login"
                    onAction="#goToLogin"
                    styleClass="secondaryBtn"/>
        </HBox>

    </VBox>

</VBox>
