<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.PrivacyController"
      styleClass="auth-page"
      stylesheets="@../css/auth.css"
      spacing="12">

    <VBox styleClass="auth-heading">
        <Label text="Privacy Policy" styleClass="title"/>
        <Label fx:id="statusLabel"
               text="Read to the end to be able to accept this on the sign-up screen."
               wrapText="true"
               styleClass="muted"/>
    </VBox>

    <VBox styleClass="auth-card" spacing="10">
        <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox spacing="10">
                <Label fx:id="contentLabel" wrapText="true"/>
            </VBox>
        </ScrollPane>

        <Button fx:id="returnBtn"
                text="Return to create account"
                onAction="#returnToSignup"
                defaultButton="true"
                maxWidth="Infinity"
                styleClass="secondaryWideBtn"/>
    </VBox>

</VBox>

